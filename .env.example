ASSEMBLYAI_API_KEY=
# Optional: Groq powers the agent's reasoning and web research
GROQ_API_KEY=
# Voice agent LLM on Groq (needs Groq Dev tier; free tier is 8k tokens/min per model)
GROQ_MODEL=openai/gpt-oss-120b
# Claim extraction on every utterance, and background web research
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_RESEARCH_MODEL=openai/gpt-oss-20b
# Voice agent brain: managed (AssemblyAI built-in, default) | groq (paid tier) | gateway (Claude/GPT via AssemblyAI LLM Gateway)
VLLO_LLM=managed
VLLO_GATEWAY_MODEL=claude-sonnet-4-6
VLLO_VOICE=charles
PORT=8787
